# ===================================
# SMARTINVENTORY - Backend Environment
# ===================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env files with real credentials to version control

# ===================================
# Server Configuration
# ===================================
SERVER_PORT=5050

# ===================================
# Database Configuration
# ===================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/inventory_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ===================================
# Storage Configuration
# Options: cloudinary, local
# ===================================
SMARTINVENTORY_STORAGE_PROVIDER=cloudinary
SMARTINVENTORY_STORAGE_LOCAL_PATH=uploads
SMARTINVENTORY_STORAGE_PUBLIC_URL=http://localhost:5050/uploads

# ===================================
# Cloudinary Configuration (for image uploads)
# Get your credentials at: https://cloudinary.com
# ===================================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ===================================
# JWT Configuration
# ===================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ===================================
# CORS Configuration
# ===================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
